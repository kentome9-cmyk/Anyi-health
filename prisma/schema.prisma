generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 用户体系
// ============================================

// 超级管理员
model Admin {
  id        String   @id @default(uuid())
  username  String   @unique @db.VarChar(100)
  password  String   @db.Text
  name      String?  @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin")
}

// 门店用户（登录凭证）
model StoreUser {
  id           String   @id @default(uuid())
  phone        String   @unique @db.VarChar(20)
  password     String   @db.Text
  name         String?  @db.VarChar(50)
  status       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 关联
  stores Store[]

  @@map("store_user")
}

// ============================================
// 门店与客户
// ============================================

// 门店表
model Store {
  id             String    @id @default(uuid())
  storeUserId    String
  storeName      String    @db.VarChar(255)
  description    String?   @db.Text
  address        String?   @db.VarChar(255)
  contactPhone   String?   @db.VarChar(50)
  status         Boolean   @default(true)
  expirationTime DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // 关联
  storeUser      StoreUser    @relation(fields: [storeUserId], references: [id], onDelete: Cascade)
  customers       Customer[]
  plans           Plan[]
  reports         Report[]
  bodyRecords     BodyRecord[]
  aiAnalyses      AiAnalysis[]

  @@index([storeUserId])
  @@index([status])
  @@map("store")
}

// 客户档案表
model Customer {
  id                  String    @id @default(uuid())
  storeId             String
  phone               String    @db.VarChar(20)
  password            String?   @db.Text  // 客户登录密码（可选，顾客可设置）
  name                String    @db.VarChar(50)
  age                 Int?      // 年龄
  postpartumDays      Int?
  postpartumTime      DateTime? @db.Date
  allergy             String?   @db.Text
  notes               String?   @db.Text
  birthOrder          Int?      // 胎次（第几胎）
  deliveryMethod      String?   @db.VarChar(20) // 顺产/剖腹产
  hasAbortionHistory  Boolean   @default(false)
  height              Decimal?  @db.Decimal(5, 2) // 身高（cm）
  weight              Decimal?  @db.Decimal(5, 2) // 体重（kg）
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // 关联
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plans           Plan[]
  reports         Report[]
  bodyRecords     BodyRecord[]
  aiAnalyses      AiAnalysis[]

  @@index([storeId])
  @@index([phone])
  @@index([name])
  @@map("customer")
}

// ============================================
// 核心业务表
// ============================================

// 客户调理方案表
model Plan {
  id                 String    @id @default(uuid())
  storeId            String
  customerId         String
  reportId           String?
  version            Int       @default(1)
  status             String    @default("active") @db.VarChar(20) // active/completed/cancelled
  rawContent         Json?     // 原始内容
  structuredContent  Json      // 结构化内容
  isLatest           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  completedAt        DateTime? @db.Timestamptz
  coreProjects       Json?     // 核心项目
  assistantProjects  Json?     // 辅助项目
  actualCounts       Json?     // 实际次数

  // 关联
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bodyRecords  BodyRecord[]

  @@index([storeId])
  @@index([customerId])
  @@index([isLatest])
  @@map("plan")
}

// 客户报告单表
model Report {
  id              String    @id @default(uuid())
  storeId         String
  customerId      String
  type            String    @default("text") @db.VarChar(20) // text/image/mixed
  content         String?   @db.Text
  images          Json?     // 图片数组
  structuredData  Json?     // 结构化数据
  createdAt       DateTime  @default(now())

  // 关联
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId])
  @@map("report")
}

// 客户身体记录表
model BodyRecord {
  id          String   @id @default(uuid())
  storeId     String
  customerId  String
  planId      String?
  visitCount  Int      // 到店次数
  visitDate   DateTime @db.Date
  records     Json     // 记录数据
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  // 关联
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan    Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([customerId])
  @@index([planId])
  @@map("body_record")
}

// ============================================
// AI 相关表
// ============================================

// AI 设置表
model AiSettings {
  id           String   @id @default(uuid())
  storeId      String?  // 为空则表示全局设置
  
  // 答复 API（用于对话/分析）
  apiKey       String?  @db.Text
  agentId      String?  @db.VarChar(255)
  datasetId    String?  @db.VarChar(255)
  baseUrl      String?  @db.VarChar(500)
  modelId      String?  @db.VarChar(255)
  
  // 向量 API（用于知识库检索/Embedding）
  embeddingApiKey    String?  @db.Text
  embeddingBaseUrl   String?  @db.VarChar(500)
  embeddingModelId  String?  @db.VarChar(255)
  
  systemPrompt String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ai_settings")
}

// AI 分析记录表
model AiAnalysis {
  id              String   @id @default(uuid())
  storeId         String   @default("default")
  customerId      String
  content         String?  @db.Text
  reportContent   String?  @db.Text
  structuredData  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关联
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId])
  @@map("ai_analysis")
}

// ============================================
// 知识库表
// ============================================

// 产后健康管理知识库
model KnowledgeBase {
  id              String   @id @default(uuid())
  project         String   @db.VarChar(255)     // 项目名称
  manifestation   String   @db.Text              // 表现
  pairingEffect   String   @db.Text              // 搭配效果
  symptom         String   @db.Text              // 症状
  pairingItem     String   @db.VarChar(255)     // 搭配项目
  pairingReason   String   @db.Text              // 搭配原因
  carePlan        String   @db.Text             // 调理规划
  effectEstimation String  @db.Text             // 效果预估
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("knowledge_base")
}
