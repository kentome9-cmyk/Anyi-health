generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 用户体系
// ============================================

// 超级管理员
model Admin {
  id        String   @id @default(uuid())
  username  String   @unique @db.VarChar(100)
  password  String   @db.Text
  name      String?  @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedMaterials ScriptMaterial[]

  @@map("admin")
}

// ============================================
// 系统设置 / 登录日志
// ============================================

// 登录日志
model LoginLog {
  id           String   @id @default(uuid())
  userType     String   @db.VarChar(20)   // admin/store_user/customer
  userId       String?                     // 登录失败时为 null
  userName     String?  @db.VarChar(100)   // 登录失败时为输入的用户名/手机号
  ip           String?  @db.VarChar(50)
  userAgent    String?  @db.Text
  success      Boolean
  errorMessage String?  @db.VarChar(255)
  createdAt    DateTime @default(now())

  @@index([userType, userId])
  @@index([createdAt])
  @@map("login_log")
}

// 系统设置（key-value）
model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  value       String?  @db.Text
  description String?  @db.VarChar(255)
  updatedBy   String?  @db.VarChar(100)
  updatedAt   DateTime @updatedAt

  @@map("system_setting")
}

// 操作日志
model OperationLog {
  id          String   @id @default(uuid())
  operatorType String  @db.VarChar(20)   // admin/store_user
  operatorId  String?                     // 操作者ID
  operatorName String? @db.VarChar(100)   // 操作者名称/用户名
  action      String   @db.VarChar(50)   // 操作类型：create/update/delete/export/reset_password等
  module      String   @db.VarChar(50)   // 模块：customer/store/ai_settings/prompt/admin等
  targetId    String?                     // 操作对象ID
  targetName  String?  @db.VarChar(255)   // 操作对象名称（冗余，便于展示）
  detail      String?  @db.Text           // 操作详情（JSON或文本）
  ip          String?  @db.VarChar(50)
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([operatorType, operatorId])
  @@index([module, action])
  @@index([createdAt])
  @@map("operation_log")
}

// 门店用户（登录凭证）
model StoreUser {
  id           String   @id @default(uuid())
  phone        String   @unique @db.VarChar(20)
  password     String   @db.Text
  name         String?  @db.VarChar(50)
  status       Boolean  @default(true)
  // 微信相关字段（三端统一，unionId 优先）
  wxOpenid     String?  @unique @map("wx_openid") @db.VarChar(100)    // 公众号 openid
  wxMpOpenid   String?  @unique @map("wx_mp_openid") @db.VarChar(100) // 小程序 openid
  wxUnionid    String?  @unique @map("wx_unionid") @db.VarChar(100)   // 微信 unionid
  wxNickname   String?  @map("wx_nickname") @db.VarChar(100)          // 微信昵称
  wxAvatar     String?  @map("wx_avatar") @db.Text                    // 微信头像
  // 功能权限（JSON 数组，如 ["customer_manage", "short_video"]）
  permissions  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 关联
  stores Store[]

  @@map("store_user")
}

// ============================================
// 门店与客户
// ============================================

// 门店表
model Store {
  id             String    @id @default(uuid())
  storeUserId    String
  storeName      String    @db.VarChar(255)
  description    String?   @db.Text
  address        String?   @db.VarChar(255)
  contactPhone   String?   @db.VarChar(50)
  status         Boolean   @default(true)
  expirationTime DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // 关联
  storeUser             StoreUser    @relation(fields: [storeUserId], references: [id], onDelete: Cascade)
  customers             Customer[]
  plans                 Plan[]
  reports               Report[]
  bodyRecords           BodyRecord[]
  aiAnalyses            AiAnalysis[]
  creatorIdentity       CreatorIdentity?
  scriptRecords         ScriptRecord[]
  topics                Topic[]
  menstrualChatSessions MenstrualChatSession[]

  @@index([storeUserId])
  @@index([status])
  @@map("store")
}

// 客户档案表
model Customer {
  id                  String    @id @default(uuid())
  storeId             String
  phone               String    @db.VarChar(20)
  password            String?   @db.Text  // 客户登录密码（可选，顾客可设置）
  name                String    @db.VarChar(50)
  age                 Int?      // 年龄
  postpartumDays      Int?
  postpartumTime      DateTime? @db.Date
  allergy             String?   @db.Text
  notes               String?   @db.Text
  birthOrder          Int?      // 胎次（第几胎）
  deliveryMethod      String?   @db.VarChar(20) // 顺产/剖腹产
  hasAbortionHistory  Boolean   @default(false)
  height              Decimal?  @db.Decimal(5, 2) // 身高（cm）
  weight              Decimal?  @db.Decimal(5, 2) // 体重（kg）
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // 关联
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plans           Plan[]
  reports         Report[]
  bodyRecords     BodyRecord[]
  aiAnalyses      AiAnalysis[]

  @@unique([storeId, phone], name: "customer_storeId_phone_unique")
  @@index([storeId])
  @@index([phone])
  @@index([name])
  @@map("customer")
}

// ============================================
// 核心业务表
// ============================================

// 客户调理方案表
model Plan {
  id                 String    @id @default(uuid())
  storeId            String
  customerId         String
  reportId           String?
  version            Int       @default(1)
  status             String    @default("active") @db.VarChar(20) // active/completed/cancelled
  rawContent         Json?     // 原始内容
  structuredContent  Json      // 结构化内容
  isLatest           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  completedAt        DateTime? @db.Timestamptz
  coreProjects       Json?     // 核心项目
  assistantProjects  Json?     // 辅助项目
  actualCounts       Json?     // 实际次数

  // 关联
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bodyRecords  BodyRecord[]

  @@index([storeId])
  @@index([customerId])
  @@index([isLatest])
  @@map("plan")
}

// 客户报告单表
model Report {
  id              String    @id @default(uuid())
  storeId         String
  customerId      String
  type            String    @default("text") @db.VarChar(20) // text/image/mixed
  content         String?   @db.Text
  images          Json?     // 图片数组
  structuredData  Json?     // 结构化数据
  createdAt       DateTime  @default(now())

  // 关联
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId])
  @@map("report")
}

// 客户身体记录表
model BodyRecord {
  id          String   @id @default(uuid())
  storeId     String
  customerId  String
  planId      String?
  visitCount  Int      // 到店次数
  visitDate   DateTime @db.Date
  records     Json     // 记录数据
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  // 关联
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan    Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([customerId])
  @@index([planId])
  @@map("body_record")
}

// ============================================
// AI 相关表
// ============================================

// AI 设置表
model AiSettings {
  id           String   @id @default(uuid())
  module       String   @unique @default("default")  // 模块标识：default, qa, content, analysis
  
  // 答复 API（用于对话/分析）
  apiKey       String?  @db.Text
  agentId      String?  @db.VarChar(255)
  datasetId    String?  @db.VarChar(255)
  baseUrl      String?  @db.VarChar(500)
  modelId      String?  @db.VarChar(255)
  
  // 向量 API（用于知识库检索/Embedding）
  embeddingApiKey    String?  @db.Text
  embeddingBaseUrl   String?  @db.VarChar(500)
  embeddingModelId  String?  @db.VarChar(255)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ai_settings")
}

// 提示词模板表
model Prompt {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)     // 提示词名称，如"方案搭配"、"选题策划"
  type        String   @db.VarChar(50)      // 类型标识，如"plan", "topic"
  description String?  @db.Text             // 描述说明
  content     String   @db.Text             // 提示词内容，包含 {变量名} 占位符
  isActive    Boolean  @default(true)       // 是否启用
  sortOrder   Int      @default(0)          // 排序
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prompt")
}
// AI 分析记录表
model AiAnalysis {
  id              String   @id @default(uuid())
  storeId         String   @default("default")
  customerId      String
  content         String?  @db.Text
  reportContent   String?  @db.Text
  structuredData  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关联
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId])
  @@map("ai_analysis")
}



// ============================================
// 内容生成模板表
// ============================================

model ContentTemplate {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(200)     // 模板名称
  description   String?  @db.Text              // 描述
  prompt        String   @db.Text              // 提示词内容
  variables     String?  @db.Text              // 变量说明（JSON格式）
  outputFormat  String   @default("text") @db.VarChar(50) // 输出格式
  exampleOutput String?  @db.Text              // 示例输出
  usageCount    Int      @default(0)           // 使用次数
  isActive      Boolean  @default(true)        // 是否启用
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("content_template")
}

// ============================================
// 问答库表
// ============================================

model QaItem {
  id        String   @id @default(uuid())
  question  String   @db.Text              // 问题
  answer    String   @db.Text              // 回答
  category  String?  @db.VarChar(100)      // 分类
  keywords  String?  @db.Text              // 关键词
  hitCount  Int      @default(0)           // 命中次数
  isActive  Boolean  @default(true)        // 是否启用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("qa_item")
}



// ============================================
// 知识库表
// ============================================

// 产后健康管理知识库
model KnowledgeBase {
  id              String   @id @default(uuid())
  project         String   @db.VarChar(255)     // 项目名称
  manifestation   String   @db.Text              // 表现
  pairingEffect   String   @db.Text              // 搭配效果
  symptom         String   @db.Text              // 症状
  pairingItem     String   @db.VarChar(255)     // 搭配项目
  pairingReason   String   @db.Text              // 搭配原因
  carePlan        String   @db.Text             // 调理规划
  effectEstimation String  @db.Text             // 效果预估
  embedding       Json?                          // 文本向量（Embedding）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("knowledge_base")
}

// 月经助手知识库
model MenstrualKnowledgeBase {
  id              String   @id @default(uuid())
  category        String   @db.VarChar(100)      // 分类：月经问题、排卵期调理、痛经、周期异常等
  symptom         String   @db.Text              // 症状表现
  cause           String   @db.Text              // 原因分析
  suggestion      String   @db.Text              // 建议方案
  dietAdvice      String   @db.Text              // 饮食建议
  lifestyleAdvice String   @db.Text             // 生活建议
  attention       String   @db.Text              // 注意事项
  embedding       Json?                          // 文本向量（Embedding）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("menstrual_knowledge_base")
}

// 产品库表
model Product {
  id             String   @id @default(uuid())
  category       String   @db.VarChar(100)      // 产品分类：私护产品、足浴泡脚、膏方食养、茶饮等
  name           String   @db.VarChar(255)      // 产品名称
  spec           String?  @db.VarChar(100)      // 规格
  price          String?  @db.VarChar(50)       // 价格
  ingredients    String?  @db.Text              // 主要成分
  effects        String?  @db.Text              // 产品功效
  targetAudience String?  @db.Text              // 适用人群
  usage          String?  @db.Text              // 使用方式
  embedding      Json?                          // 文本向量（Embedding）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@map("product")
}

// 调理方案库表（产品搭配）
model HealthPlan {
  id             String   @id @default(uuid())
  type           String   @db.VarChar(100)      // 调理类型：补气血、调理睡眠、痛经调理等
  targetAudience String?  @db.Text              // 适用人群
  productCombo   String?  @db.Text              // 推荐产品组合
  usage          String?  @db.Text              // 使用方式
  embedding      Json?                          // 文本向量（Embedding）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
  @@map("health_plan")
}

// ============================================
// 月经助手 - 聊天会话表
// ============================================
model MenstrualChatSession {
  id             String   @id @default(uuid())
  storeId        String
  title          String   @db.VarChar(255)      // 会话标题（取第一条消息或用户输入）
  messageCount   Int      @default(0)           // 消息数量
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 关联
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages       MenstrualChatMessage[]

  @@index([storeId])
  @@index([updatedAt])
  @@map("menstrual_chat_session")
}

// ============================================
// 月经助手 - 聊天消息表
// ============================================
model MenstrualChatMessage {
  id             String   @id @default(uuid())
  sessionId      String
  role           String   @db.VarChar(20)       // user/assistant
  content        String   @db.Text              // 消息内容
  createdAt      DateTime @default(now())

  // 关联
  session        MenstrualChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("menstrual_chat_message")
}



// ============================================
// 短视频创作 - 创作者身份（全局唯一）
// ============================================
model CreatorIdentity {
  id              String   @id @default(uuid())
  storeId         String   @unique
  contentTrack    String   @db.VarChar(100)     // 内容赛道
  personaStyle    String   @db.VarChar(200)     // 人设风格
  targetAudience  String   @db.VarChar(500)     // 目标受众
  videoTone       String?  @db.VarChar(100)     // 视频调性
  videoDuration   String?  @db.VarChar(100)     // 视频时长
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关联
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("creator_identity")
}

// ============================================
// 短视频创作 - 选题表
// ============================================
model Topic {
  id              String   @id @default(uuid())
  storeId         String
  topic           String   @db.VarChar(255)      // 选题标题
  summary         String?  @db.Text              // 内容摘要
  angle           String?  @db.Text              // 切入角度
  corePoints      String?  @db.Text              // 补充说明/核心观点
  contentDirection String? @db.VarChar(50)       // 内容方向：教知识/聊观点/讲故事/晒过程
  isRecommended   Boolean  @default(false)        // 是否推荐
  totalViews      Int      @default(0)           // 总播放量（汇总所有版本的脚本）
  totalLikes      Int      @default(0)           // 总点赞量
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关联
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  scripts         ScriptRecord[]

  @@index([storeId])
  @@index([topic])
  @@index([contentDirection])
  @@map("topic")
}

// ============================================
// 短视频创作 - 脚本记录表
// ============================================
model ScriptRecord {
  id              String   @id @default(uuid())
  storeId         String
  topicId         String?                        // 关联选题ID
  type            String   @db.VarChar(20)       // original/rewrite/material
  version         Int      @default(1)            // 版本号
  topicTitle      String?  @db.VarChar(255)      // 选题标题（冗余，便于展示）
  summary         String?  @db.Text              // 内容摘要
  angle           String?  @db.Text              // 切入角度
  corePoints      String?  @db.Text              // 核心观点
  sourceContent   String?  @db.Text              // 原文（改写模式）
  templateName    String?  @db.VarChar(200)     // 使用的模板名称
  content         String   @db.Text              // 生成的脚本内容
  viewCount       Int      @default(0)           // 播放量
  likeCount       Int      @default(0)            // 点赞量
  commentCount    Int      @default(0)            // 评论量
  favoriteCount   Int      @default(0)            // 收藏量
  isRecommended   Boolean  @default(false)        // 是否推荐
  isFilmed        Boolean  @default(false)        // 是否已拍摄
  isPublic        Boolean  @default(false)        // 是否加入公共脚本库
  sourceMaterialId String?                       // 关联的素材ID（改写来源）
  number          String?  @db.VarChar(50)        // 编号（素材导入时使用）
  direction       String?  @db.VarChar(100)       // 方向（素材导入时使用）
  subCategory     String?  @db.VarChar(100)       // 子类（素材导入时使用）
  createdAt       DateTime @default(now())

  // 关联
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  topic           Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sourceMaterial  ScriptMaterial? @relation(fields: [sourceMaterialId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([topicId])
  @@index([type])
  @@index([isRecommended])
  @@index([isPublic])
  @@index([sourceMaterialId])
  @@index([direction])
  @@index([subCategory])
  @@map("script_records")
}

// 管理员上传的脚本素材（供门店参考/改写）
model ScriptMaterial {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(255)        // 素材标题
  number        String   @db.VarChar(50)         // 编号
  direction     String   @db.VarChar(100)        // 方向
  subCategory   String   @db.VarChar(100)        // 子类
  content       String   @db.Text                // 素材内容（原文）
  source        String?  @db.VarChar(255)        // 来源（可选，如：抖音某博主、某书某作者）
  category      String?  @db.VarChar(100)        // 分类（可选）
  uploadedById  String?                          // 上传者（管理员ID）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  uploader      Admin?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  rewrites      ScriptRecord[]

  @@index([category])
  @@index([direction])
  @@index([subCategory])
  @@index([uploadedById])
  @@map("script_materials")
}

// ============================================
// 学习中心 - 学习资源表
// ============================================
model LearningResource {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(255)     // 资源标题
  type        String   @db.VarChar(20)      // 资源类型：md/ppt
  category    String   @db.VarChar(100)     // 分类：培训课程、产品知识、营销技巧等
  description String?  @db.Text             // 描述说明
  content     String?  @db.Text             // MD文档内容（type=md时使用）
  filePath    String?  @db.VarChar(500)     // 文件路径（type=ppt时使用，存储PDF或图片路径）
  pageCount   Int?     @default(0)          // PPT页数
  fileSize    String?  @db.VarChar(50)      // 文件大小
  isActive    Boolean  @default(true)       // 是否启用
  sortOrder   Int      @default(0)          // 排序
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([isActive])
  @@map("learning_resource")
}

// ============================================
// 学习中心 - 分类表（管理员可自定义）
// ============================================
model LearningCategory {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)  // 分类名称
  sortOrder   Int      @default(0)               // 排序
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("learning_category")
}
