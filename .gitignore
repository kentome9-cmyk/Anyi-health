# ============================================
# Git 忽略规则 - Anyi-health 项目
# ============================================
# 此文件定义了不应上传到 Git 仓库的文件和目录
# ============================================

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (环境变量文件，包含敏感信息，禁止提交)
/.env
.env.*
!.env.example

# postpartum-health (后端项目，独立仓库)
../postpartum-health/

# typescript
*.tsbuildinfo
next-env.d.ts

# test data files (API test payloads)
login.json
login2.json
newadmin.json
reset.json
cookies.txt

# ============================================
# 本地上传文件目录
# ============================================
# public/uploads/learning/ - 测试数据文件（包含客户培训资料等本地测试数据）
# 注意：生产环境应在服务器上单独配置存储，不要将包含真实数据的文件上传到仓库
public/uploads/learning/*
